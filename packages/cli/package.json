{
  "name": "@fe/cli",
  "version": "0.2.3",
  "type": "module",
  "bin": {
    "fe": "./src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./bootstrap": "./src/bootstrap.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --format esm --target bun",
    "typecheck": "bunx tsgo --noEmit"
  },
  "dependencies": {
    "@fe/compiler": "workspace:*",
    "@fe/core": "workspace:*",
    "@fe/runtime": "workspace:*",
    "@fe/specifier": "workspace:*"
  },
  "devDependencies": {
    "@typescript/native-preview": "latest",
    "bun-types": "latest"
  }
}
